<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The widget extension runs sandboxed: no network, no access to the home folder. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- The one exception: read-only access to the snapshot folder the app writes. App groups need a team id,
	     which an ad-hoc signature does not have. -->
	<key>com.apple.security.temporary-exception.files.home-relative-path.read-only</key>
	<array>
		<string>/Library/Application Support/Codometer/Widget/</string>
	</array>
</dict>
</plist>
