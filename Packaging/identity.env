# Codometer identity: the single source of the bundle identifiers and the repository.
# Sourced by Scripts/build-app.sh, which writes the identifiers into both Info.plists when it assembles the bundle.
# Bundle identifiers key widget placements, notification permission, the login item and preferences: freeze them
# before tagging 1.0.0. The widget identifier must start with the app identifier followed by a dot.
CODOMETER_BUNDLE_ID="com.codometer.Codometer"
CODOMETER_WIDGETS_BUNDLE_ID="com.codometer.Codometer.Widgets"
# GitHub "<owner>/<repo>". When it is set, Scripts/build-app.sh
# writes https://github.com/<owner>/<repo> into the bundle as the Info.plist key CodometerRepositoryURL,
# which is where the About panel reads it from; the app never reads this file.
CODOMETER_REPOSITORY="iexbase/Codometer"
